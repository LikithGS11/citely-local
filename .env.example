# Environment settings
ENVIRONMENT=development

# PostgreSQL Database Configuration (pgvector enabled)
POSTGRES_SERVER=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_rag
POSTGRES_PORT=5432

# Redis Configuration (Celery broker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AI / LLM Provider Configuration
# Options: "ollama" (local Ollama server, no API key), "openai", or "local" (no LLM - extractive answers)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=8192
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# Embeddings. EMBEDDING_DIMENSION must match the model; changing it requires
# re-creating the document_chunks table and re-ingesting documents.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Browser origins allowed to call the API (JSON list). Auth is disabled, so keep this tight.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# API and Frontend Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
